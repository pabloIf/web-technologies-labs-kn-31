<h2>Login</h2>

<% if (messages.error) { %>
    <p style="color:red"><%= messages.error %></p>
<% } %>

<form action="/login" method="POST">
    <input name="email" placeholder="Email" value="<%= old.email || '' %>">
    <input name="password" type="password" placeholder="password">
    <button>Login</button>
</form>
<a href="/register">Register</a>
